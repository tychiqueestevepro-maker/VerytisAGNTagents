# ════════════════════════════════════════════════════════════════════════════
# agents-engine — variables d'environnement
# Copier ce fichier : cp .env.example .env
# NE JAMAIS committer le .env dans Git
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings > API > URL
SUPABASE_URL="https://ton-id-projet.supabase.co"

# Project Settings > API > service_role (secret) — NE PAS exposer côté client
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."

# ── LLM Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-proj-..."
# Optionnel : pour les modèles Claude
ANTHROPIC_API_KEY="sk-ant-..."

# ── Services externes ─────────────────────────────────────────────────────────
WHATSAPP_API_URL="https://graph.facebook.com/v19.0/TON_PHONE_NUMBER_ID"
WHATSAPP_API_TOKEN="EAA..."

# SERP optionnel pour renforcer la qualification avec des sources publiques recentes
SERPAPI_API_KEY=""
SERP_RECENCY_MONTHS="3"
SERP_RESULTS_PER_QUERY="5"
SERP_TIMEOUT_MS="5500"

# ── Agent UUIDs ───────────────────────────────────────────────────────────────
# À renseigner après avoir executé le seed Supabase (INSERT INTO agents ...)
# Récupérer avec : SELECT id, slug FROM agents;
AGENT_ID_ENRICHMENT=""
AGENT_ID_QUALIFIER=""
AGENT_ID_COPYWRITER=""
AGENT_ID_QA=""

# ── Workflow step UUIDs ───────────────────────────────────────────────────────
# À renseigner après avoir créé le workflow et ses étapes dans Supabase
# Récupérer avec : SELECT id, name FROM workflow_steps WHERE workflow_id = '...';
STEP_ID_ENRICHMENT=""
STEP_ID_QUALIFIER=""
STEP_ID_COPYWRITER=""
STEP_ID_QA=""

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
